{
  "name": "rotunda",
  "version": "1.1.4",
  "description": "Bidirectional config sync tool with LLM-assisted review",
  "type": "module",
  "bin": {
    "rotunda": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "node test/run.mjs test/**/*.test.ts",
    "test:unit": "node test/run.mjs test/unit/**/*.test.ts",
    "test:integration": "node test/run.mjs test/integration/**/*.test.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "lint": "eslint src/ test/ && tsc --noEmit && tsc --noEmit -p test/tsconfig.json"
  },
  "keywords": [
    "dotfiles",
    "sync",
    "config",
    "bidirectional"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "cross-spawn": "^7.0.6",
    "minimatch": "^10.0.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.19.21",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.2"
  }
}
